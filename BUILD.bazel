load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

COPTS = ["-std=c99", "-Wall", "-Wextra", "-Werror", "-DPARENA_NO_GRAPHICS"]

cc_library(
    name = "witness_rules",
    srcs = ["core/witness_rules.c"],
    hdrs = ["core/witness_rules.h"],
    includes = ["core", "core/runtime"],
    copts = COPTS,
    textual_hdrs = glob(["core/runtime/*"]),
)

cc_test(
    name = "witness_rules_test",
    srcs = ["tests/test_witness_rules.c"],
    data = ["tests/parity_vectors.txt"],
    args = ["$(location tests/parity_vectors.txt)"],
    deps = [":witness_rules"],
    copts = COPTS,
)

cc_binary(
    name = "bigo_sim",
    srcs = ["apps/bigo_sim/main.c", "core/sim.c", "core/sim.h", "core/mission.c", "core/mission.h", "core/world.c", "core/world.h", "core/world_rules.c", "core/world_rules.h", "core/world_alerts.c", "core/reflux_runtime.c", "core/reflux_runtime.h"],
    deps = [":witness_rules"],
    copts = COPTS + ["-DBIGO_VERSION=\\\"bazel\\\""],
)

# humanness -- MISHRI-derived mood/energy/timing-jitter primitives (S504, founder real-time:
# "start building the AI brain attention mechanisms and values and all the mishri stuff"),
# vendored verbatim from SHANKPIT/packages/simulation/humanness.c (2026-09-20, proven there via
# SHANKPIT's own HUMANNESS_NORTHSTAR.md Phase 1/2). Plain C, not PARENA, by design -- runs every
# tick per NPC, needs to be fast, not author-editable per-instance (same reasoning gband.c's own
# sampler already established).
cc_library(
    name = "humanness",
    srcs = ["core/humanness.c"],
    hdrs = ["core/humanness.h"],
    copts = COPTS,
)

cc_test(
    name = "humanness_test",
    srcs = ["core/humanness_test.c"],
    deps = [":humanness"],
    copts = COPTS,
)

# npc_archetype -- the real attention-mechanism integration point for Citizens and The Men: gives
# core/witness_rules.c's own static per-NPC vigilance (docs/B1_WITNESS_RULES.md §5) a real,
# dynamic, mood-modulated value to read instead, via humanness.c. See core/npc_archetype.h's own
# doc comment for the full design and what's deliberately deferred.
cc_library(
    name = "npc_archetype",
    srcs = ["core/npc_archetype.c"],
    hdrs = ["core/npc_archetype.h"],
    deps = [":humanness"],
    copts = COPTS,
)

cc_test(
    name = "npc_archetype_test",
    srcs = ["core/npc_archetype_test.c"],
    deps = [":npc_archetype"],
    copts = COPTS,
)

# zombie_values -- zombies' OWN attention/value vocabulary (hunger/aggression/decay, a 4-state
# mood arc), deliberately NOT a variant of humanness.c's human mood set -- see
# core/zombie_values.h's own top doc comment for why. Independent of :humanness on purpose.
cc_library(
    name = "zombie_values",
    srcs = ["core/zombie_values.c"],
    hdrs = ["core/zombie_values.h"],
    copts = COPTS,
)

cc_test(
    name = "zombie_values_test",
    srcs = ["core/zombie_values_test.c"],
    deps = [":zombie_values"],
    copts = COPTS,
)

# avian_values -- "the birds" (docs/DESIGN_DIGEST.md's Act II hyper-intelligent avian coalition):
# the coalition's OWN attention/value vocabulary (vigilance/coordination/exposure, a 4-state mood
# arc ROOSTING/SCOUTING/SIGNALING/MOBBING, a real acoustic-beacon-strength output), the TYLER
# canon reconciliation NORTHSTAR.md §6 and docs/DESIGN_DIGEST.md both flag as needed (Eastwind
# Owls / "Bird Correction") -- see core/avian_values.h's own top doc comment for the full tie-in.
# Same "own RNG-free math, no shared code with sibling value modules" convention as :zombie_values.
# Independent of :zombie_values/:witness_rules on purpose -- avian_beacon_strength is a real,
# tested output with a named future consumer (zombie_get_agitated), not yet wired live.
cc_library(
    name = "avian_values",
    srcs = ["core/avian_values.c"],
    hdrs = ["core/avian_values.h"],
    copts = COPTS,
)

cc_test(
    name = "avian_values_test",
    srcs = ["core/avian_values_test.c"],
    deps = [":avian_values"],
    copts = COPTS,
)

# lab_sim -- founder real-time: "build out all of the cloning facility simulation tech we want to
# simulate real lab equipment as much as possible." Headless equipment pipeline (centrifuge, PCR,
# sequencer, CRISPR splice bench, repressor/kill-switch install, breeding/genetic drift, embryo
# incubation) covering every real piece of gear docs/DESIGN_DIGEST.md §5/§6 names, with its own
# named realism hooks (contamination/alignment, guide-RNA off-target, genetic drift, nonsense-
# mediated decay, cryptic splice sites, retrotransposon-style copying) as live mechanics. Same
# "own RNG, no shared code with sibling value modules" convention as :zombie_values. Independent
# of :witness_rules/:npc_archetype/:zombie_values on purpose -- not yet wired into the day/ server's
# BP_APP_LAB UI (see NORTHSTAR.md's own lab-sim section for what's deferred).
cc_library(
    name = "lab_sim",
    srcs = ["core/lab_sim.c"],
    hdrs = ["core/lab_sim.h"],
    copts = COPTS,
    # public: day/packages/common/bigo_lab.h (EMILY/BACKLOG.md SECTION 536 follow-up, BIG_O/
    # NORTHSTAR.md §30) is the first real cross-package consumer -- the day/packages/common
    # package's own bigo_lab_test needs this label visible outside the root package.
    visibility = ["//visibility:public"],
)

cc_test(
    name = "lab_sim_test",
    srcs = ["core/lab_sim_test.c"],
    deps = [":lab_sim"],
    copts = COPTS,
)

# witness_live -- pure glue (S504-DISPATCH) wiring the live ServerNpc/zombie population
# (day/apps/server/src/main.c) into :witness_rules' own real npc_next_state/effective_witnesses
# for the LOUD-event ("a HUNTING/FRENZIED zombie is visible") witnessing path. Header-only, matching
# day/packages/common/bigo_pheromone.h's own "extract testable logic" convention; depends on
# :witness_rules and :zombie_values rather than owning any C source of its own.
cc_test(
    name = "witness_live_test",
    srcs = ["core/witness_live_test.c", "core/witness_live.h"],
    deps = [":witness_rules", ":zombie_values"],
    copts = COPTS,
)

# giant_bug_brain -- the real, PARENA-compiled Giant Zombie Bug decision network (EMILY/
# BACKLOG.md SECTION 536 reverse-port phase 2, "bring SHANKPIT stuff back into BIG_O" -- brought
# back from SHANKPIT, where it was built natively, forward of the original BIG_O engine merge).
# Generated from PARENA/stdlib/big_o/giant_bug_brain.prn via `parena build`, committed here.
# Same "own include path for parena_runtime.h" shape :witness_rules already establishes.
cc_library(
    name = "giant_bug_brain",
    srcs = ["core/giant_bug_brain.c"],
    includes = ["core", "core/runtime"],
    copts = COPTS,
    textual_hdrs = glob(["core/runtime/*"]),
)

# giant_bug_values -- Giant Zombie Bug's own alien value system (state/tick/eat), deliberately NOT
# a variant of zombie_values.h's own hunger/aggression/decay vocabulary -- see
# core/giant_bug_values.h's own top doc comment for why. Depends on :zombie_values for
# giant_bug_eat_zombie's own real prey type + zombie_reaction_delay_ms, and :giant_bug_brain for
# the real PARENA-computed decision outputs.
cc_library(
    name = "giant_bug_values",
    srcs = ["core/giant_bug_values.c"],
    hdrs = ["core/giant_bug_values.h"],
    deps = [":zombie_values", ":giant_bug_brain"],
    copts = COPTS,
)

cc_test(
    name = "giant_bug_values_test",
    srcs = ["core/giant_bug_values_test.c"],
    deps = [":giant_bug_values"],
    copts = COPTS,
)
