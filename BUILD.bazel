load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

COPTS = ["-std=c99", "-Wall", "-Wextra", "-Werror", "-DPARENA_NO_GRAPHICS"]

cc_library(
    name = "witness_rules",
    srcs = ["core/witness_rules.c"],
    hdrs = ["core/witness_rules.h"],
    includes = ["core", "core/runtime"],
    copts = COPTS,
    textual_hdrs = glob(["core/runtime/*"]),
)

cc_test(
    name = "witness_rules_test",
    srcs = ["tests/test_witness_rules.c"],
    data = ["tests/parity_vectors.txt"],
    args = ["$(location tests/parity_vectors.txt)"],
    deps = [":witness_rules"],
    copts = COPTS,
)

cc_binary(
    name = "bigo_sim",
    srcs = ["apps/bigo_sim/main.c", "core/sim.c", "core/sim.h", "core/mission.c", "core/mission.h", "core/world.c", "core/world.h", "core/world_rules.c", "core/world_rules.h", "core/world_alerts.c", "core/reflux_runtime.c", "core/reflux_runtime.h"],
    deps = [":witness_rules"],
    copts = COPTS + ["-DBIGO_VERSION=\\\"bazel\\\""],
)

# humanness -- MISHRI-derived mood/energy/timing-jitter primitives (S504, founder real-time:
# "start building the AI brain attention mechanisms and values and all the mishri stuff"),
# vendored verbatim from SHANKPIT/packages/simulation/humanness.c (2026-09-20, proven there via
# SHANKPIT's own HUMANNESS_NORTHSTAR.md Phase 1/2). Plain C, not PARENA, by design -- runs every
# tick per NPC, needs to be fast, not author-editable per-instance (same reasoning gband.c's own
# sampler already established).
cc_library(
    name = "humanness",
    srcs = ["core/humanness.c"],
    hdrs = ["core/humanness.h"],
    copts = COPTS,
)

cc_test(
    name = "humanness_test",
    srcs = ["core/humanness_test.c"],
    deps = [":humanness"],
    copts = COPTS,
)

# npc_archetype -- the real attention-mechanism integration point for Citizens and The Men: gives
# core/witness_rules.c's own static per-NPC vigilance (docs/B1_WITNESS_RULES.md §5) a real,
# dynamic, mood-modulated value to read instead, via humanness.c. See core/npc_archetype.h's own
# doc comment for the full design and what's deliberately deferred.
cc_library(
    name = "npc_archetype",
    srcs = ["core/npc_archetype.c"],
    hdrs = ["core/npc_archetype.h"],
    deps = [":humanness"],
    copts = COPTS,
)

cc_test(
    name = "npc_archetype_test",
    srcs = ["core/npc_archetype_test.c"],
    deps = [":npc_archetype"],
    copts = COPTS,
)

# zombie_values -- zombies' OWN attention/value vocabulary (hunger/aggression/decay, a 4-state
# mood arc), deliberately NOT a variant of humanness.c's human mood set -- see
# core/zombie_values.h's own top doc comment for why. Independent of :humanness on purpose.
cc_library(
    name = "zombie_values",
    srcs = ["core/zombie_values.c"],
    hdrs = ["core/zombie_values.h"],
    copts = COPTS,
)

cc_test(
    name = "zombie_values_test",
    srcs = ["core/zombie_values_test.c"],
    deps = [":zombie_values"],
    copts = COPTS,
)

# lab_sim -- founder real-time: "build out all of the cloning facility simulation tech we want to
# simulate real lab equipment as much as possible." Headless equipment pipeline (centrifuge, PCR,
# sequencer, CRISPR splice bench, repressor/kill-switch install, breeding/genetic drift, embryo
# incubation) covering every real piece of gear docs/DESIGN_DIGEST.md §5/§6 names, with its own
# named realism hooks (contamination/alignment, guide-RNA off-target, genetic drift, nonsense-
# mediated decay, cryptic splice sites, retrotransposon-style copying) as live mechanics. Same
# "own RNG, no shared code with sibling value modules" convention as :zombie_values. Independent
# of :witness_rules/:npc_archetype/:zombie_values on purpose -- not yet wired into the day/ server's
# BP_APP_LAB UI (see NORTHSTAR.md's own lab-sim section for what's deferred).
cc_library(
    name = "lab_sim",
    srcs = ["core/lab_sim.c"],
    hdrs = ["core/lab_sim.h"],
    copts = COPTS,
)

cc_test(
    name = "lab_sim_test",
    srcs = ["core/lab_sim_test.c"],
    deps = [":lab_sim"],
    copts = COPTS,
)
